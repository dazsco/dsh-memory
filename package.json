{
  "name": "dsh-memory",
  "description": "DSH-native memory plugin: global + per-project memory, AGENTS.md rules, background Dream consolidation, a /memory composer command, and a GUI management surface",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:scale": "node --test \"tests/**/*.slow.mjs\"",
    "bench": "node scripts/bench.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "memory",
    "dream",
    "sleep-time-compute",
    "bitemporal",
    "commands"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:D:/Repos/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-atomic-write": "link:D:/Repos/deepseek-harness/packages/util/atomic-write",
    "@deepseek-ai/dsh-home-paths": "link:D:/Repos/deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-llm": "link:D:/Repos/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-settings": "link:D:/Repos/deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-timeout": "link:D:/Repos/deepseek-harness/packages/util/timeout",
    "@deepseek-ai/dsh-tools": "link:D:/Repos/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-util-values": "link:D:/Repos/deepseek-harness/packages/util/values",
    "@deepseek-ai/schemastery": "link:D:/Repos/deepseek-harness/vendor/schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.3-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:D:/Repos/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-locale": "link:D:/Repos/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:D:/Repos/deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:D:/Repos/deepseek-harness/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-client-ui-renderer": "link:D:/Repos/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "link:D:/Repos/deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:D:/Repos/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/schemastery": "link:D:/Repos/deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.0"
  },
  "license": "MIT"
}
