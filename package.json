{
  "name": "dsh-memory",
  "description": "DSH memory system plugin: global + per-project memory folders, AGENTS.md memory rules, and background Dream consolidation (sleep-time compute)",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "memory",
    "dream",
    "sleep-time-compute"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:D:/Repos/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-atomic-write": "link:D:/Repos/deepseek-harness/packages/util/atomic-write",
    "@deepseek-ai/dsh-home-paths": "link:D:/Repos/deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-llm": "link:D:/Repos/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-settings": "link:D:/Repos/deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-timeout": "link:D:/Repos/deepseek-harness/packages/util/timeout",
    "@deepseek-ai/dsh-tools": "link:D:/Repos/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-util-values": "link:D:/Repos/deepseek-harness/packages/util/values",
    "@deepseek-ai/schemastery": "link:D:/Repos/deepseek-harness/vendor/schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:D:/Repos/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-locale": "link:D:/Repos/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:D:/Repos/deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-renderer": "link:D:/Repos/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "link:D:/Repos/deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "link:D:/Repos/deepseek-harness/packages/client/ui-settings-plugins",
    "@deepseek-ai/dsh-client-ui-slots": "link:D:/Repos/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/schemastery": "link:D:/Repos/deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.0"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
